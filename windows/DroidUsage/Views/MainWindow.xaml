<Window
    x:Class="DroidUsage.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Factory Droid Usage">

    <Grid
        x:Name="RootGrid"
        Background="#0D0D0D"
        BorderBrush="#222222"
        BorderThickness="1"
        CornerRadius="6">

        <Grid
            x:Name="CollapsedPillPanel"
            Visibility="{x:Bind ViewModel.IsCollapsed, Mode=OneWay}"
            Padding="12,0,6,0"
            Background="Transparent"
            PointerPressed="DragRegion_PointerPressed"
            PointerMoved="DragRegion_PointerMoved"
            PointerReleased="CollapsedPill_PointerReleased">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Ellipse
                x:Name="PillStatusDot"
                Grid.Column="0"
                Width="7"
                Height="7"
                Fill="#FF5800"
                VerticalAlignment="Center"
                Margin="0,0,8,0" />

            <TextBlock
                x:Name="PillBucketLabel"
                Grid.Column="1"
                Text="{x:Bind ViewModel.PillLabel, Mode=OneWay}"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="#FFFFFF"
                VerticalAlignment="Center"
                Margin="0,0,6,0" />

            <TextBlock
                x:Name="PillPercentText"
                Grid.Column="2"
                Text="{x:Bind ViewModel.PillPercentText, Mode=OneWay}"
                FontSize="12"
                FontWeight="Normal"
                Foreground="#808080"
                VerticalAlignment="Center"
                Margin="0,0,10,0" />

            <Grid
                x:Name="PillBarTrack"
                Grid.Column="3"
                MinWidth="44"
                Height="6"
                Background="#262626"
                CornerRadius="2"
                VerticalAlignment="Center"
                SizeChanged="PillBarTrack_SizeChanged">
                <Border
                    x:Name="PillBarFill"
                    Width="0"
                    Height="6"
                    Background="#FF5800"
                    CornerRadius="2"
                    HorizontalAlignment="Left" />
            </Grid>

            <TextBlock
                x:Name="PillResetText"
                Grid.Column="4"
                Text="{x:Bind ViewModel.PillResetText, Mode=OneWay}"
                FontSize="11"
                Foreground="#888888"
                VerticalAlignment="Center"
                Margin="9,0,4,0" />

            <Button
                x:Name="ExpandButton"
                Grid.Column="5"
                Command="{x:Bind ViewModel.ExpandCommand}"
                Width="26"
                Height="26"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                ToolTipService.ToolTip="Expand Usage Limits">
                <FontIcon Glyph="&#xE70D;" FontSize="10" Foreground="#808080" />
            </Button>
        </Grid>

        <Grid
            x:Name="ExpandedCardPanel"
            Visibility="{x:Bind ViewModel.IsExpanded, Mode=OneWay}"
            VerticalAlignment="Top"
            Padding="18,14,18,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid
                Grid.Row="0"
                Background="Transparent"
                Margin="0,0,0,18"
                PointerPressed="DragRegion_PointerPressed"
                PointerMoved="DragRegion_PointerMoved"
                PointerReleased="DragRegion_PointerReleased">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <Image
                        x:Name="FactoryLogoImage"
                        Width="16"
                        Height="16"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Text="Usage Limits"
                        FontSize="13.5"
                        FontWeight="SemiBold"
                        Foreground="#FFFFFF"
                        VerticalAlignment="Center" />
                    <Border
                        x:Name="PlanBadgeBorder"
                        Visibility="{x:Bind ViewModel.HasPlanTier, Mode=OneWay}"
                        Background="#1A1A1A"
                        BorderBrush="#333333"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="6,1.5"
                        VerticalAlignment="Center">
                        <TextBlock
                            x:Name="PlanBadgeText"
                            Text="{x:Bind ViewModel.PlanTier, Mode=OneWay}"
                            FontSize="10.5"
                            FontWeight="SemiBold"
                            Foreground="#FF5800"
                            VerticalAlignment="Center" />
                    </Border>
                </StackPanel>

                <Border
                    Grid.Column="1"
                    Background="#141414"
                    BorderBrush="#292929"
                    BorderThickness="1"
                    CornerRadius="3"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" Spacing="0">
                        <Button
                            x:Name="StandardPoolTabButton"
                            Command="{x:Bind ViewModel.SelectStandardPoolCommand}"
                            Content="Standard"
                            FontSize="11.5"
                            FontWeight="SemiBold"
                            Padding="11,4"
                            MinHeight="0"
                            MinWidth="0"
                            CornerRadius="2,0,0,2"
                            Background="#FFFFFF"
                            Foreground="#0D0D0D"
                            BorderThickness="0" />
                        <Button
                            x:Name="CorePoolTabButton"
                            Command="{x:Bind ViewModel.SelectCorePoolCommand}"
                            Content="Droid Core"
                            FontSize="11.5"
                            FontWeight="Normal"
                            Padding="11,4"
                            MinHeight="0"
                            MinWidth="0"
                            CornerRadius="0,2,2,0"
                            Background="Transparent"
                            Foreground="#8C8C8C"
                            BorderThickness="0" />
                    </StackPanel>
                </Border>

                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="0"
                    VerticalAlignment="Center">
                    <Button
                        x:Name="RefreshButton"
                        Command="{x:Bind ViewModel.RefreshCommand}"
                        Width="24"
                        Height="24"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="Refresh usage">
                        <FontIcon Glyph="&#xE72C;" FontSize="11" Foreground="#737373" />
                    </Button>
                    <Button
                        x:Name="SettingsToggleButton"
                        Command="{x:Bind ViewModel.ToggleSettingsCommand}"
                        Width="24"
                        Height="24"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="Settings">
                        <FontIcon Glyph="&#xE713;" FontSize="11" Foreground="#737373" />
                    </Button>
                    <Button
                        x:Name="CollapseButton"
                        Command="{x:Bind ViewModel.CollapseCommand}"
                        Width="24"
                        Height="24"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="Collapse to compact pill">
                        <FontIcon Glyph="&#xE70E;" FontSize="11" Foreground="#737373" />
                    </Button>
                </StackPanel>
            </Grid>

            <StackPanel
                x:Name="UsageContentPanel"
                Visibility="{x:Bind ViewModel.IsShowingUsage, Mode=OneWay}"
                Grid.Row="1"
                Spacing="18"
                SizeChanged="UsageContentPanel_SizeChanged">

                <Border
                    Visibility="{x:Bind ViewModel.IsUpdateAvailable, Mode=OneWay}"
                    Background="#1A1A1A"
                    BorderBrush="#FF5800"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10,6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Text="{x:Bind ViewModel.UpdateBannerText, Mode=OneWay}"
                            FontSize="12"
                            Foreground="#FFFFFF"
                            VerticalAlignment="Center" />
                        <Button
                            Grid.Column="1"
                            Command="{x:Bind ViewModel.InstallUpdateCommand}"
                            IsEnabled="{x:Bind ViewModel.IsNotUpdating, Mode=OneWay}"
                            Content="Update"
                            FontSize="11.5"
                            FontWeight="SemiBold"
                            Padding="10,3"
                            MinHeight="0"
                            Background="#FF5800"
                            Foreground="#FFFFFF"
                            BorderThickness="0" />
                    </Grid>
                </Border>

                <StackPanel Spacing="7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <TextBlock
                                Text="5-hour usage"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#FFFFFF" />
                            <TextBlock
                                x:Name="FiveHourPercentText"
                                Text="{x:Bind ViewModel.FiveHour.PercentText, Mode=OneWay}"
                                FontSize="12.5"
                                FontWeight="Normal"
                                Foreground="#7A7A7A"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon
                                x:Name="FiveHourSyncIcon"
                                Visibility="{x:Bind ViewModel.FiveHour.IsActive, Mode=OneWay}"
                                Glyph="&#xE72C;"
                                FontSize="11"
                                Foreground="#888888"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="FiveHourResetText"
                                Text="{x:Bind ViewModel.FiveHour.ResetText, Mode=OneWay}"
                                FontSize="12"
                                Foreground="#888888"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <Grid
                        x:Name="FiveHourBarTrack"
                        Height="7"
                        Background="#262626"
                        CornerRadius="2">
                        <Border
                            x:Name="FiveHourBarFill"
                            Width="0"
                            Height="7"
                            Background="#FF5800"
                            CornerRadius="2"
                            HorizontalAlignment="Left" />
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <TextBlock
                                Text="Weekly usage"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#FFFFFF" />
                            <TextBlock
                                x:Name="WeeklyPercentText"
                                Text="{x:Bind ViewModel.Weekly.PercentText, Mode=OneWay}"
                                FontSize="12.5"
                                FontWeight="Normal"
                                Foreground="#7A7A7A"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon
                                x:Name="WeeklySyncIcon"
                                Visibility="{x:Bind ViewModel.Weekly.IsActive, Mode=OneWay}"
                                Glyph="&#xE72C;"
                                FontSize="11"
                                Foreground="#888888"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="WeeklyResetText"
                                Text="{x:Bind ViewModel.Weekly.ResetText, Mode=OneWay}"
                                FontSize="12"
                                Foreground="#888888"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <Grid
                        x:Name="WeeklyBarTrack"
                        Height="7"
                        Background="#262626"
                        CornerRadius="2">
                        <Border
                            x:Name="WeeklyBarFill"
                            Width="0"
                            Height="7"
                            Background="#FF5800"
                            CornerRadius="2"
                            HorizontalAlignment="Left" />
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <TextBlock
                                Text="Monthly usage"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#FFFFFF" />
                            <TextBlock
                                x:Name="MonthlyPercentText"
                                Text="{x:Bind ViewModel.Monthly.PercentText, Mode=OneWay}"
                                FontSize="12.5"
                                FontWeight="Normal"
                                Foreground="#7A7A7A"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon
                                x:Name="MonthlySyncIcon"
                                Visibility="{x:Bind ViewModel.Monthly.IsActive, Mode=OneWay}"
                                Glyph="&#xE72C;"
                                FontSize="11"
                                Foreground="#888888"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="MonthlyResetText"
                                Text="{x:Bind ViewModel.Monthly.ResetText, Mode=OneWay}"
                                FontSize="12"
                                Foreground="#888888"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <Grid
                        x:Name="MonthlyBarTrack"
                        Height="7"
                        Background="#262626"
                        CornerRadius="2">
                        <Border
                            x:Name="MonthlyBarFill"
                            Width="0"
                            Height="7"
                            Background="#FF5800"
                            CornerRadius="2"
                            HorizontalAlignment="Left" />
                    </Grid>
                </StackPanel>
            </StackPanel>

            <StackPanel
                x:Name="SettingsContentPanel"
                Grid.Row="1"
                Visibility="{x:Bind ViewModel.IsShowingSettings, Mode=OneWay}"
                Spacing="10">

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock
                            Text="Compact Pill Metric"
                            FontSize="11"
                            Foreground="#8C8C8C" />
                        <ComboBox
                            x:Name="PillMetricComboBox"
                            SelectionChanged="PillMetricComboBox_SelectionChanged"
                            HorizontalAlignment="Stretch"
                            FontSize="12">
                            <ComboBoxItem Content="5-hour usage" Tag="fiveHour" />
                            <ComboBoxItem Content="Weekly usage" Tag="weekly" />
                            <ComboBoxItem Content="Monthly usage" Tag="monthly" />
                            <ComboBoxItem Content="Highest active" Tag="highest" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock
                            Text="Refresh Interval"
                            FontSize="11"
                            Foreground="#8C8C8C" />
                        <ComboBox
                            x:Name="RefreshIntervalComboBox"
                            SelectionChanged="RefreshIntervalComboBox_SelectionChanged"
                            HorizontalAlignment="Stretch"
                            FontSize="12">
                            <ComboBoxItem Content="15 seconds" Tag="15" />
                            <ComboBoxItem Content="30 seconds" Tag="30" />
                            <ComboBoxItem Content="1 minute" Tag="60" />
                            <ComboBoxItem Content="2 minutes" Tag="120" />
                            <ComboBoxItem Content="5 minutes" Tag="300" />
                            <ComboBoxItem Content="10 minutes" Tag="600" />
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="4">
                    <TextBlock
                        Text="Manual Token / API Key (Optional)"
                        FontSize="11"
                        Foreground="#8C8C8C" />
                    <PasswordBox
                        x:Name="ManualApiKeyBox"
                        Password="{x:Bind ViewModel.ManualApiKey, Mode=TwoWay}"
                        PlaceholderText="Leave empty to use ~/.factory auth automatically"
                        FontSize="11" />
                </StackPanel>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Text="{x:Bind ViewModel.AppVersionText}"
                        FontSize="11"
                        Foreground="#8C8C8C"
                        VerticalAlignment="Center" />
                    <Button
                        Grid.Column="1"
                        Command="{x:Bind ViewModel.CheckForUpdatesCommand}"
                        Content="Check for updates"
                        FontSize="11.5" />
                </Grid>

                <Grid ColumnSpacing="8" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Grid.Column="0"
                        Command="{x:Bind ViewModel.SaveSettingsCommand}"
                        Content="Save &amp; Back"
                        HorizontalAlignment="Stretch"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Background="#FF5800"
                        Foreground="#FFFFFF"
                        BorderThickness="0" />
                    <Button
                        Grid.Column="1"
                        Click="HideToTrayButton_Click"
                        Content="Hide to Tray"
                        FontSize="12" />
                </Grid>
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="LastRefreshText"
                    Grid.Column="0"
                    Text="{x:Bind ViewModel.LastRefreshText, Mode=OneWay}"
                    FontSize="11"
                    Foreground="#6E6E6E"
                    VerticalAlignment="Center" />

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="4"
                    VerticalAlignment="Center">
                    <TextBlock
                        Text="Status:"
                        FontSize="11"
                        Foreground="#6E6E6E"
                        VerticalAlignment="Center" />
                    <TextBlock
                        x:Name="RefreshStatusText"
                        Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="#A3A3A3"
                        VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
